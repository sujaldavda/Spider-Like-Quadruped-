<?xml version="1.0"?>
<!--
  Spider-Like Quadruped, 12 DOF (SG90).
  Frame: x forward, y left, z up. Meshes are the assembly-space STLs (mm, Y-up),
  placed with scale 0.001 and rpy "1.5708 0 1.5708".
  Zero joint angles = CAD assembly pose. Joint axis points from servo body to horn.
  Joint limits = CAD self-collision sweep (3 deg steps, other joints at zero) capped at +/-90 deg servo travel.
  Masses: SG90 9 g, horn 0.5 g, printed parts 0.8 g/cm3, electronics + 2S 18650 lumped as 130 g in base.
-->
<robot name="spider_quadruped">

  <material name="print"><color rgba="0.85 0.85 0.85 1"/></material>
  <material name="servo"><color rgba="0.15 0.35 0.8 1"/></material>
  <material name="horn"><color rgba="0.95 0.95 0.95 1"/></material>

  <!-- ===================== BASE ===================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.0086" rpy="0 0 0"/>
      <mass value="0.2025"/>
      <inertia ixx="7.194e-05" ixy="0" ixz="0" iyy="7.012e-05" iyz="0" izz="1.310e-04"/>
    </inertial>
    <visual>
      <origin xyz="-0.0675254 -0.132465 -0.054649" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="../meshes/quadrapod reddit - base 5.0 remake-1.STL" scale="0.001 0.001 0.001"/></geometry>
      <material name="print"/>
    </visual>
    <visual>
      <origin xyz="-0.0675254 -0.132465 -0.054649" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="../meshes/quadrapod reddit - Servo_motor.step-1.STL" scale="0.001 0.001 0.001"/></geometry>
      <material name="servo"/>
    </visual>
    <visual>
      <origin xyz="-0.0675254 -0.132465 -0.054649" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="../meshes/quadrapod reddit - Servo_motor.step-4.STL" scale="0.001 0.001 0.001"/></geometry>
      <material name="servo"/>
    </visual>
    <visual>
      <origin xyz="-0.0675254 -0.132465 -0.054649" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="../meshes/quadrapod reddit - Servo_motor.step-5.STL" scale="0.001 0.001 0.001"/></geometry>
      <material name="servo"/>
    </visual>
    <visual>
      <origin xyz="-0.0675254 -0.132465 -0.054649" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="../meshes/quadrapod reddit - Servo_motor.step-6.STL" scale="0.001 0.001 0.001"/></geometry>
      <material name="servo"/>
    </visual>
    <collision>
      <origin xyz="-0.0675254 -0.132465 -0.054649" rpy="1.5708 0 1.5708"/>
      <geometry><mesh filename="../meshes/quadrapod reddit - base 5.0 remake-1.STL" scale="0.001 0.001 0.001"/></geometry>
    </collision>
  </link>

  <!-- ===================== FRONT LEFT ===================== -->
